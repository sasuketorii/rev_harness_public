# --- Agents Base / Hydra Flow ---
workspace/
# .shared/ is per-clone runtime identity and stays ignored, EXCEPT
# rev_harness_version.json which is rev_harness's own version source-of-truth
# and must be trackable so it can be tagged. Ignore contents (not the dir
# itself) so the negation below can re-include the one tracked file.
.shared/*
!.shared/rev_harness_version.json
.claude/tmp/
.claude/scheduled_tasks.lock
.claude/*.lock
.npm-cache/
.semantic-mcp/*/semantic.db
.semantic-mcp/*/semantic.db-shm
.semantic-mcp/*/semantic.db-wal
# Project-local pointer to the externally-placed semantic DB (P2+pointer).
# Lazily written by semantic-mcp on open; never commit it.
.rev_harness/
.rev_harness/semantic-db.json
semantic-db.json
semantic.db
semantic.db-wal
semantic.db-shm
.migration.lock
.agent/project_id
.agent/tmp/
.agent/context/**
!.agent/context/.gitkeep
.agent/registry/*.jsonl
# Cursor wrapper ask-mode write-attempt test residue
.agent-write-test-*
.ask-readonly-*

# --- Node.js ---
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
dist/
build/
.next/

# --- Python (Modern / uv) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/

# --- Rust ---
target/
**/*.rs.bk

# --- System / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.log

# --- Defense-in-depth: prevent accidental commit of credentials / private keys ---
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
id_ecdsa*
.codex/auth.json
.claude/.credentials.json
.aws/credentials
.npmrc

# Codex raw transcripts (audit-only, regenerable, contains absolute paths)
**/_codex_inputs/
**/_codex_outputs/

# --- RevHarness runtime residue (ephemeral; never commit) ---
# NOTE: do NOT blanket-ignore .agent/state/ — dual_lgtm_state.json is I-3
# evidence and MUST remain trackable. Only path-specific lock/runtime residue
# below is ignored.
.agent/snapshots/
.agent/state/*.lock
.agent/state/*.lock.d/
.agent/state/locks/
.agent/state/review_queue/
.agent/active/**/context.json
# Belt-and-suspenders: never let the lock rules accidentally swallow I-3 evidence.
!.agent/state/dual_lgtm_state.json

# Append-only runtime metrics that are generated by local gates but are not
# tracked release evidence streams.
.agent/metrics/settings_merge_wire_events.jsonl
.agent/metrics/review_queue_events.jsonl
# Wrapper invocation telemetry: runtime-generated, not a tracked release
# evidence stream. Use the exact filename (NOT *.jsonl) so the 13 already-tracked
# .agent/metrics/*.jsonl phase/gate evidence files are never shadowed.
.agent/metrics/wrapper_events.jsonl
# Safe-dispatch event telemetry: runtime-generated append-only stream, never a
# tracked release evidence file (exact filename, not a blanket *.jsonl).
.agent/metrics/dispatch_events.jsonl

# Self-growth feedback memory: runtime-generated append-only streams under
# .agent/archive/feedback/. Only .gitkeep is tracked there, so ignoring the
# *.jsonl pattern in this directory shadows no tracked file.
.agent/archive/feedback/*.jsonl

# --- OD-2 lifecycle retention (S2 governance-diet) ---
# Policy: .agent/active holds ONLY in-progress work; a plan that reaches FINAL
# dual-LGTM is archived to .agent/archive/plans/<id> with a sha256 replay
# manifest (scripts/rev-harness-janitor.sh plans-archive). The archive +
# manifest are TRACKED evidence-of-record and are NOT ignored. The retention
# floor (.agent/state/dual_lgtm_state.json, .agent/metrics/phase_*_done.jsonl,
# phase_done_smoke.jsonl, release_binary_privacy_scan.jsonl, path_leak_events.jsonl)
# is never deleted. See docs/manual/rev-harness-lifecycle.md.
#
# The genuinely runtime, append-only telemetry streams are already ignored
# above by exact filename (settings_merge_wire_events / review_queue_events /
# wrapper_events). All other .agent/metrics/*.jsonl are tracked phase/gate
# evidence and MUST NOT be shadowed — do NOT add a blanket .agent/metrics/*.jsonl
# rule here. Active-tree scratch from interrupted runs (never evidence):
.agent/active/**/*.tmp
.agent/active/**/*.partial
